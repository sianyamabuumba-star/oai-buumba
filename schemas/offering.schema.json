{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obuuma.example/schemas/offering.schema.json",
  "title": "O'BUUMBA Universal Offering Record",
  "description": "Shared record for services, physical and digital products, software, creative IP, consulting, evaluation work and internal initiatives. Replace the example schema host before publishing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "offeringType", "businessUnitId", "lifecycleStage", "recordStatus", "createdAt", "updatedAt"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,63}$"},
    "name": {"type":"string","minLength":1,"maxLength":160},
    "summary": {"type":"string","maxLength":2000},
    "offeringType": {"enum":["service","physical_product","digital_product","software_or_saas","creative_ip","consulting","ai_evaluation","internal_initiative","community_program"]},
    "businessUnitId": {"type":"string"},
    "revenueTrackId": {"type":["string","null"]},
    "lifecycleStage": {"enum":["opportunity","research","validation","definition","planning","development","quality_assurance","launch_ready","active","marketing","sales","fulfilment","support","improvement","growth","paused","retirement","retired"]},
    "recordStatus": {"enum":["draft","needs_review","approved","blocked","archived"]},
    "customerProblem": {"type":"string","maxLength":3000},
    "audience": {"type":"array","items":{"type":"string"},"maxItems":30},
    "stakeholders": {
      "type":"object",
      "properties": {
        "creatorOrOwner":{"type":["string","null"]},
        "user":{"type":["string","null"]},
        "beneficiary":{"type":["string","null"]},
        "buyer":{"type":["string","null"]},
        "payer":{"type":["string","null"]},
        "approver":{"type":["string","null"]}
      },
      "additionalProperties":false
    },
    "offer": {
      "type":"object",
      "properties": {
        "scope":{"type":"array","items":{"type":"string"}},
        "deliverables":{"type":"array","items":{"type":"string"}},
        "exclusions":{"type":"array","items":{"type":"string"}},
        "revisionPolicy":{"type":["string","null"]},
        "acceptanceCriteria":{"type":"array","items":{"type":"string"}},
        "supportCommitment":{"type":["string","null"]}
      },
      "additionalProperties":false
    },
    "commercial": {
      "type":"object",
      "properties": {
        "currency":{"type":"string","pattern":"^[A-Z]{3}$"},
        "price":{"type":["number","null"],"minimum":0},
        "priceStatus":{"enum":["not_set","draft_estimate","approved","quoted","contracted","not_applicable"]},
        "costAssumptions":{"type":"array","items":{"type":"string"}},
        "verifiedCosts":{"type":"array","items":{"type":"object","required":["amount","currency","evidenceRef"],"properties":{"amount":{"type":"number","minimum":0},"currency":{"type":"string"},"evidenceRef":{"type":"string"}}}},
        "paymentStatus":{"enum":["not_applicable","not_due","unverified","pending","partially_verified","verified_paid","refunded","disputed"]}
      },
      "additionalProperties":false
    },
    "marketValidation": {
      "type":"object",
      "properties": {
        "demandEvidence":{"type":"array","items":{"type":"string"}},
        "competitorReferences":{"type":"array","items":{"type":"string","format":"uri"}},
        "assumptions":{"type":"array","items":{"type":"string"}},
        "validationDecision":{"enum":["not_started","insufficient_evidence","promising","validated","rejected","revisit"]}
      },
      "additionalProperties":false
    },
    "production": {
      "type":"object",
      "properties": {
        "tools":{"type":"array","items":{"type":"string"}},
        "dependencies":{"type":"array","items":{"type":"string"}},
        "sourceAssets":{"type":"array","items":{"type":"string"}},
        "deliverableRefs":{"type":"array","items":{"type":"string"}},
        "qualityChecks":{"type":"array","items":{"type":"object","required":["check","status"],"properties":{"check":{"type":"string"},"status":{"enum":["not_started","pass","fail","waived_with_reason"]},"evidenceRef":{"type":"string"},"reviewer":{"type":"string"}}}},
        "rightsAndLicensing":{"type":"array","items":{"type":"object","required":["assetOrTool","status"],"properties":{"assetOrTool":{"type":"string"},"status":{"enum":["unknown","under_review","cleared","restricted","permission_required","not_applicable"]},"evidenceRef":{"type":"string"}}}}
      },
      "additionalProperties":false
    },
    "marketing":{"type":"object","properties":{"channels":{"type":"array","items":{"type":"string"}},"campaignRefs":{"type":"array","items":{"type":"string"}},"publicationStatus":{"enum":["not_planned","draft","awaiting_approval","scheduled","published","paused"]}},"additionalProperties":false},
    "sales":{"type":"object","properties":{"enquiryRefs":{"type":"array","items":{"type":"string"}},"quoteRefs":{"type":"array","items":{"type":"string"}},"orderRefs":{"type":"array","items":{"type":"string"}},"salesPipelineStage":{"type":["string","null"]}},"additionalProperties":false},
    "fulfilment":{"type":"object","properties":{"checklist":{"type":"array","items":{"type":"string"}},"deliveryRefs":{"type":"array","items":{"type":"string"}},"deliveryConfirmedAt":{"type":["string","null"],"format":"date-time"},"customerAcceptanceEvidence":{"type":["string","null"]}},"additionalProperties":false},
    "supportAndImprovement":{"type":"object","properties":{"supportOwner":{"type":["string","null"]},"feedbackRefs":{"type":"array","items":{"type":"string"}},"metrics":{"type":"array","items":{"type":"object","required":["name","value","measuredAt"],"properties":{"name":{"type":"string"},"value":{"type":["number","string"]},"unit":{"type":"string"},"measuredAt":{"type":"string","format":"date-time"},"evidenceRef":{"type":"string"}}}},"nextReviewAt":{"type":["string","null"],"format":"date-time"}},"additionalProperties":false},
    "governance":{"type":"object","properties":{"legalEntityId":{"type":["string","null"]},"contractStatus":{"enum":["not_required","not_started","draft","awaiting_authorised_review","approved","executed","expired"]},"privacyReview":{"enum":["not_required","not_started","pending","approved","blocked"]},"riskLevel":{"enum":["low","medium","high","critical","not_assessed"]},"approvalRefs":{"type":"array","items":{"type":"string"}}},"additionalProperties":false},
    "ownerId":{"type":["string","null"]},
    "startDate":{"type":["string","null"],"format":"date"},
    "targetLaunchDate":{"type":["string","null"],"format":"date"},
    "retirementReason":{"type":["string","null"]},
    "createdAt":{"type":"string","format":"date-time"},
    "updatedAt":{"type":"string","format":"date-time"},
    "version":{"type":"integer","minimum":1,"default":1},
    "auditRefs":{"type":"array","items":{"type":"string"}}
  }
}